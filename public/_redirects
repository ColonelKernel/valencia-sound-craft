# Per-route rewrites are generated ABOVE this file's content into
# dist/_redirects by build/stampRouteHeadsPlugin.ts (one bare + one
# trailing-slash rule per ROUTE_META route, so new routes are covered
# automatically). There is deliberately NO /* SPA catch-all: "/" is served by
# index.html natively, every real route has an explicit rewrite, and unmatched
# paths fall through to Netlify's automatic 404 handling, which serves
# dist/404.html (a shell copy that mounts the SPA NotFound page) with a real
# 404 status instead of soft-404ing as the homepage.

# The Groove Atlas is retired. Its own path and the older /groove-intelligence
# one both land on the rhythm engine, which still mounts the same world map.
/groove-atlas           /tools/rhythm    301
/groove-intelligence    /tools/rhythm    301

# /tools/map mounted GlobalRhythmEngine with the same props as /tools/rhythm,
# and the atlas renders inside that engine — it was the same tool at two URLs.
# Merged; the old URL keeps working.
/tools/map              /tools/rhythm    301
